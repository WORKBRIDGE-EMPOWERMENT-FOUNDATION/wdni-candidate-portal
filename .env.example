# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address of the portal (used in invite messages)
# Local: http://localhost:3000. Production (Vercel): https://portal.wdni.ng
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Sign-in codes by SMS (Termii) — OFF for now ----
# Set to true only after finishing Part B of docs/sign-in-codes.md
NEXT_PUBLIC_PHONE_SIGNIN=false
# Supabase → Authentication → Hooks → Send SMS hook → "Generate secret" (starts with v1,whsec_)
SEND_SMS_HOOK_SECRET=v1,whsec_replace-me
# Termii dashboard → API settings
TERMII_API_KEY=your-termii-api-key
TERMII_BASE_URL=https://your-account.api.termii.com
# Your approved Termii sender ID (max 11 characters), e.g. Workbridge
TERMII_SENDER_ID=Workbridge
# "dnd" (recommended, reaches Do-Not-Disturb numbers) or "generic"
TERMII_CHANNEL=dnd

# Bulk email to candidates (/admin/messages). Google Workspace SMTP with an app password
# (Google Account → Security → 2-Step Verification → App passwords). Workspace allows ~2,000 emails a day.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@workbridgefoundation.org
SMTP_PASS=your-16-character-app-password
MAIL_FROM="WDNI Candidate Portal <admin@workbridgefoundation.org>"
